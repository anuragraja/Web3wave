# ==========================================
# Web3Wave Server Environment Configuration
# ==========================================

# Server Port & Environment
PORT=5004
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/web3wave?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/web3wave?retryWrites=true&w=majority

# JWT Secrets for Authentication (Use strong, randomly generated keys in production)
JWT_SECRET=your_strong_jwt_access_secret_key
REFRESH_SECRET=your_strong_jwt_refresh_secret_key
REFRESH_EXPIRES_IN=7d

# Redis Configuration (Used for token blacklists, refresh sessions, and OTP rate-limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Brevo (Sendinblue) Transactional Email API
# 1. Obtain your API key at: https://app.brevo.com/settings/keys/api
# 2. Add your server/dev machine IP to Authorized IPs: https://app.brevo.com/security/authorised_ips
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_NAME=Web3Wave
BREVO_SENDER_MAIL=noreply@web3wave.in

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth 2.0 Web Client Credentials
GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER=

# Administrative Account Defaults
ADMIN_EMAIL=admin@web3wave.in
ADMIN_PASSWORD=AdminSecurePassword@123
ADMIN_NAME=Admin
ADMIN_NUMBER=9876543210
